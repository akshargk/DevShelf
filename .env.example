# DevShelf Environment Variables

# Backend Port
PORT=5000

# Module 1 & 2: PostgreSQL with Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/devshelf_db?schema=public"

# Module 3: MongoDB Document Store
MONGODB_URL="mongodb://127.0.0.1:27017/devshelf_db"

# JWT Authentication Secret
JWT_SECRET="devshelf_super_secret_jwt_key_2026"

# Frontend Client URL
CLIENT_URL="http://localhost:5173"
